<%- include('../partials/header') %>

<h1>Manage Products</h1>

<% if (error) { %><p class="alert"><%= error %></p><% } %>

<h2>Add Product</h2>
<form method="post" action="/admin/products" class="form">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <label>Name <input type="text" name="name" required></label>
    <label>Description <textarea name="description"></textarea></label>
    <label>Price <input type="number" step="0.01" name="price" required></label>
    <label>Image URL <input type="url" name="image" placeholder="https://images.unsplash.com/..."></label>
    <button type="submit">Add Product</button>
</form>

<h2>Existing Products</h2>
<table class="cart-table">
    <tr><th>Image</th><th>Name</th><th>Price</th><th></th></tr>
    <% products.forEach(function(p) { %>
        <tr>
            <td><img class="product-img-thumb" src="<%= p.image %>" alt="<%= p.name %>"></td>
            <td><%= p.name %></td>
            <td>$<%= Number(p.price).toFixed(2) %></td>
            <td>
                <form method="post" action="/admin/products/<%= p.id %>/delete" class="inline-form">
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    <% }); %>
</table>

<%- include('../partials/footer') %>
