<%- include('partials/header') %>

<h1>Your Cart</h1>

<% if (items.length === 0) { %>
    <p>Your cart is empty. <a href="/products">Browse products</a>.</p>
<% } else { %>
    <table class="cart-table">
        <tr><th>Product</th><th>Qty</th><th>Subtotal</th><th></th></tr>
        <% items.forEach(function(item) { %>
            <tr>
                <td><%= item.name %></td>
                <td><%= item.qty %></td>
                <td>$<%= item.subtotal.toFixed(2) %></td>
                <td>
                    <form method="post" action="/cart/remove" class="inline-form">
                        <input type="hidden" name="product_id" value="<%= item.id %>">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <button type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>
    <p class="total">Total: $<%= total.toFixed(2) %></p>
    <a href="/orders/checkout" class="button">Checkout</a>
<% } %>

<%- include('partials/footer') %>
