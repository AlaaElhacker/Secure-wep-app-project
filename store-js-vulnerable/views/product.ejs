<%- include('partials/header') %>

<h1><%= product.name %></h1>
<img class="product-img-large" src="<%= product.image %>" alt="<%= product.name %>">
<p><%= product.description %></p>
<p class="price">$<%= product.price %></p>

<form method="post" action="/cart/add" class="inline-form">
    <input type="hidden" name="product_id" value="<%= product.id %>">
    <button type="submit">Add to Cart</button>
</form>

<h2>Reviews</h2>

<% if (error) { %>
    <p class="alert"><%= error %></p>
<% } %>

<div class="reviews">
    <% reviews.forEach(function(r) { %>
        <div class="review">
            <strong><%= r.username %></strong>
            (<%= r.rating %>/5)
            <!-- ============================================
                 VULNERABLE VERSION (Person 2's task):
                 The unescaped output tag <%- %> renders the comment as
                 raw HTML/JavaScript instead of escaping it.

                 Example payload a user could submit as a review comment:
                   <script>alert(document.cookie)</script>
                 This executes in the browser of every visitor who views
                 this product page (Stored XSS), and could be used to
                 steal session cookies or perform actions as that visitor.
            ============================================ -->
            <p><%- r.comment %></p>
        </div>
    <% }); %>
</div>

<% if (isLoggedIn) { %>
    <h3>Leave a review</h3>
    <form method="post" action="/products/<%= product.id %>/reviews" class="form">
        <label>Rating
            <select name="rating">
                <option value="5">5</option>
                <option value="4">4</option>
                <option value="3">3</option>
                <option value="2">2</option>
                <option value="1">1</option>
            </select>
        </label>
        <label>Comment
            <textarea name="comment" required></textarea>
        </label>
        <button type="submit">Submit Review</button>
    </form>
<% } else { %>
    <p><a href="/login">Log in</a> to leave a review.</p>
<% } %>

<%- include('partials/footer') %>
